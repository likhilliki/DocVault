# Copy this file to .env and fill in your deployed values
# Run: cp .env.example .env

# API Gateway URL (from SAM deploy output: ApiUrl)
VITE_API_URL=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/dev

# Cognito User Pool ID (from SAM deploy output: UserPoolId)
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito App Client ID (from SAM deploy output: UserPoolClientId)
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# AWS Region
VITE_AWS_REGION=us-east-1
